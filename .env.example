# Kalshi API credentials
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading mode (default: paper)
PAPER_TRADING=true

# Risk thresholds (defaults shown; uncomment to override)
# MAX_CAPITAL_LOSS_PCT=40.0       # Kill-switch trigger: total capital drawdown from initial balance
# MAX_POSITION_PCT=30.0           # Max % of equity in any single position
# MAX_EXPOSURE_PCT=50.0           # Max % of equity across all open positions
# MAX_LOSS_PER_TRADE_PCT=25.0     # Max per-trade loss tolerance
# PRICE_CUSHION_CENTS=2           # Bid/ask cushion for live execution (0 = taker-only)
